# Allow a Git specs source when the CocoaPods CDN is unavailable.
source ENV.fetch('COCOAPODS_SPEC_SOURCE', 'https://cdn.cocoapods.org/')

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# React Native 0.72 is the last release line supporting iOS 12.4.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'
# SDWebImageSVGCoder requires iOS 13; raster cover images remain supported.
ENV['DISABLE_SVG'] = '1'
platform :ios, '12.4'
prepare_react_native_project!

# Flipper is unnecessary for playback and adds legacy build dependencies.
flipper_config = FlipperConfiguration.disabled

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'LxMusicMobile' do
  pod 'SDWebImage', '5.19.1'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :fabric_enabled => false,
    :flipper_configuration => flipper_config,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'LxMusicMobileTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    
    projects = [installer.pods_project] +
               installer.aggregate_targets.map(&:user_project)

    projects.uniq.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |config|
          definitions = Array(
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||
            '$(inherited)'
          )
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] =
            (definitions + ['FOLLY_HAVE_CLOCK_GETTIME=1']).uniq
        end
      end
      project.save
    end
    
    
    
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        # Older pods still declare iOS 8/9; keep them within the app's supported range.
        minimum = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if minimum && Gem::Version.new(minimum) < Gem::Version.new('12.4')
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.4'
        end

        # The podspec flag removes the dependency; native imports need the same flag.
        next unless target.name == 'RNFastImage'
        definitions = Array(build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || '$(inherited)')
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = (definitions + ['DISABLE_SVG=1']).uniq
      end
    end
  end
end
